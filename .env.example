# Copy file này thành .env và điền thông tin thật
# Không commit file .env lên git

# Google Business Profile API
GBP_CLIENT_ID=your_client_id.apps.googleusercontent.com
GBP_CLIENT_SECRET=GOCSPX-your_secret_here

# Cài đặt server
GBP_WEBAPP_PORT=8000

# Giai đoạn sau khi thu tiền: thêm các key sau
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=eyJ...
